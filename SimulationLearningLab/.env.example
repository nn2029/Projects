# Optional built-in AI generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Enable authoritative web research during AI spec generation
SLL_ENABLE_WEB_SEARCH=1

# Cap image/frame inputs sent to the multimodal model
SLL_MAX_MODEL_IMAGES=16

# Optional local whisper CLI model fallback
SLL_WHISPER_MODEL=base

# Session storage root
SLL_DATA_DIR=./data
